# Development app settings
# Paths are relative to server\ unless you provide an absolute path.
DEV_REGION_DIR=
DEV_ROUTING_MODE=hierarchical
DEV_CLIENT_HOST=localhost
DEV_CLIENT_PORT=3000
DEV_CLIENT_ENTRY_PATH=/public/index.html
NAV_CLIENT_SERVER_URL=http://localhost:8080
NAV_SERVER_ADDR=:8080
NAV_SERVER_DATA_DIR=
NAV_MAP_ROOT=./data/map
NAV_GEOFABRIK_CACHE_FILE=./data/geofabrik-index.json
NAV_GEOFABRIK_INDEX_URL=https://download.geofabrik.de/index-v1.json

# Optional server runtime settings for local development
NAV_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NAV_SEARCH_WARMUP_QUERY="Tel Aviv"
NAV_SEARCH_LIMIT=
NAV_SEARCH_LANGUAGE=
NAV_SEARCH_COUNTRY_CODES=
NAV_SEARCH_VIEWBOX=
NAV_SEARCH_UPSTREAM_URL=https://nominatim.openstreetmap.org/search
NAV_SEARCH_USER_AGENT=navigation-prototype/1.0
