TEST_HOST=127.0.0.1
TEST_REGION_DIR=sweden
TEST_ROUTING_MODE=hierarchical
TEST_CLIENT_ENTRY_PATH=/public/index.html
TEST_LOADBOT_ENTRY_QUERY=loadbot=1
NAV_CLIENT_SERVER_URL=http://127.0.0.1:8080
NAV_MAP_ROOT=./data/map
NAV_GEOFABRIK_CACHE_FILE=./data/geofabrik-index.json
NAV_GEOFABRIK_INDEX_URL=https://download.geofabrik.de/index-v1.json
NAV_SEARCH_UPSTREAM_URL=https://nominatim.openstreetmap.org/search
NAV_SEARCH_USER_AGENT=navigation-prototype/1.0

# End-to-end test settings
TEST_SERVER_PORT=8080
TEST_CLIENT_PORT=3000
TEST_E2E_TIMEOUT_MS=90000
TEST_E2E_EXPECT_TIMEOUT_MS=15000
TEST_E2E_SERVER_READY_TIMEOUT_MS=180000
TEST_E2E_CLIENT_READY_TIMEOUT_MS=30000
TEST_E2E_ACTION_TIMEOUT_MS=30000
TEST_E2E_CANDIDATE_ATTEMPTS=30
TEST_E2E_TRIP_INSET_FRACTION=0.18
TEST_E2E_TRIP_COMMUTE_DEGREES=0.08

# Shared trip generation settings
TEST_TRIP_MIN_DISTANCE_SQ=0.0004
TEST_TRIP_MAX_ATTEMPTS=10

# Benchmark settings
TEST_BENCH_CORPUS=sweden-bench.json
TEST_BENCH_PBF_PATH=sweden\sweden-latest.osm.pbf
TEST_BENCH_SERVER_PORT=8090
TEST_BENCH_ROUTING_MODE=hierarchical
TEST_BENCH_CONCURRENCY=40
TEST_BENCH_REQUESTS=2000
TEST_BENCH_WARMUP=100
TEST_BENCH_WARMUP_WAIT_SEC=5
TEST_BENCH_GOMAXPROCS=1 2 4 8
TEST_BENCH_REPEAT_COUNT=1
TEST_BENCH_GO_TEST_TIMEOUT=30m
TEST_BENCH_SERVER_STARTUP_WAIT_SEC=5
TEST_BENCH_CELL_SIZE=2000
TEST_BENCH_OVERLAY_RUNS=3

# Loadbot settings
TEST_LOADBOT_CLIENT_PORT=4173
TEST_LOADBOT_CLIENTS=10
TEST_LOADBOT_HEADLESS=true
TEST_LOADBOT_COMMUTE_DEGREES=0.25
TEST_LOADBOT_INSET_FRACTION=0.1
TEST_LOADBOT_STAGGER_MS=0
TEST_LOADBOT_STATS_MS=5000
TEST_LOADBOT_TRIP_END_POLL_MS=1000
TEST_LOADBOT_VIEWPORT_WIDTH=360
TEST_LOADBOT_VIEWPORT_HEIGHT=240
TEST_LOADBOT_BLOCKED_ASSETS=tile.openstreetmap.org,googleapis.com,gstatic.com
